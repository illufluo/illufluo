---
import NotePage from '../../components/NotePage.astro';
import { getNotes } from '../../lib/notes';
export async function getStaticPaths() {
  return (await getNotes()).filter((note) => note.collection === 'examples')
    .map((note) => ({ params: { id: note.id }, props: { note } }));
}
const { note } = Astro.props;
---
<NotePage note={note} />
