---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { isPreview } from '../lib/notes';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  date?: string;
  updated?: string;
  noindex?: boolean;
}
const { title, description = 'illufluo，一些想法与记录。一个不定期更新的个人记录空间。', article = false, date, updated, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · illufluo` : 'illufluo · 一些想法与记录。';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const path = Astro.url.pathname;
const nav = [{ href: '/', label: '首页' }, { href: '/archive/', label: '归档' }, { href: '/about/', label: '关于' }];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAFAF9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191D20" media="(prefers-color-scheme: dark)" />
    {(isPreview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && <link rel="sitemap" href="/sitemap.xml" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="illufluo" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {article && date && <meta property="article:published_time" content={`${date}T00:00:00+08:00`} />}
    {article && updated && <meta property="article:modified_time" content={`${updated}T00:00:00+08:00`} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (() => {
        let theme = 'system';
        try { theme = localStorage.getItem('illufluo-theme') || 'system'; } catch {}
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark'
          ? theme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="site-shell mx-auto flex w-full max-w-[620px] flex-col">
      <header class="site-header flex items-center justify-between gap-6">
        <a href="/" class="wordmark" aria-label="illufluo 首页">illufluo<span aria-hidden="true">.</span></a>
        <nav aria-label="主导航" class="flex items-center gap-6 sm:gap-7">
          {nav.map((item) => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer flex flex-wrap items-center justify-between gap-4">
        <p class="footer-signature">illufluo <span>·</span> 一些想法与记录。</p>
        <ThemeSwitch />
      </footer>
    </div>
  </body>
</html>
